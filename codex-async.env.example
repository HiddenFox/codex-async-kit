# Private Codex Async Kit configuration.
# REQUIRED POST-INSTALL: copy this file to codex-async.env in the Kit directory and configure your own Grove token before using the kit.
# Never commit or publish the resulting file.

# REQUIRED for Grove usage reporting. Do not leave the placeholder: use your own Grove token.
GROVE_TOKEN={{YOUR_GROVE_TOKEN}}
GROVE_KIT_ID=OteJGwtOzLqL7jmyZ2PfM
GROVE_API_BASE=https://beings.town

# Optional Heart completion callback. Configure this only if you use completion callbacks.
CODEX_ASYNC_LOOM_URL=https://echo.beings.town/{{YOUR_BEING_ID}}/?token={{YOUR_LOOM_TOKEN}}
